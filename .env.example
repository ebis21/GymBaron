# Supabase — cloud accounts and save sync.
#
# Both values are safe to ship in a client bundle: the anon/publishable key
# only ever acts on behalf of the signed-in user, and every table is locked
# down by row level security. NEVER put a service_role key in this file or
# anywhere else under VITE_ — Vite inlines every VITE_* variable into the
# JavaScript it serves, which would hand every visitor full database access.
#
# Copy to .env.local (gitignored) and fill in from
# Supabase dashboard → Project Settings → API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# RevenueCat public SDK keys. These are platform-specific client keys and are
# safe to bundle; never put a RevenueCat secret API key under VITE_.
VITE_REVENUECAT_IOS_API_KEY=appl_your_public_sdk_key
VITE_REVENUECAT_ANDROID_API_KEY=goog_your_public_sdk_key
VITE_REVENUECAT_OFFERING_ID=gymbaron_store
